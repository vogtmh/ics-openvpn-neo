<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer rules for Android 12+ (API 31+).

  The app's files directory contains the VPN profiles:
    <uuid>.vp     - plaintext serialized VpnProfile (may contain saved passwords
                    and inline private keys)
    <uuid>.cp     - encrypted profile (Android Keystore backed; the key does NOT
                    transfer to other devices, so a restored .cp is unreadable)
    <uuid>.cpold  - backup copy of the previous encrypted profile

  Backing these up would either leak secrets (.vp) or produce unusable garbage
  after restore (.cp), so the whole file domain is excluded. Shared preferences
  (benign app settings) remain eligible for backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
