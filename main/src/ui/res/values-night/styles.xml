<resources>

    <style name="blinkt.baseTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimaryDark">#000000</item>

        <item name="alertDialogTheme">@style/blinkt.alertDialog</item>
        <item name="materialAlertDialogTheme">@style/blinkt.materialAlertDialog</item>
        <item name="preferenceTheme">@style/blinkt.preferenceTheme</item>
        <item name="bottomSheetDialogTheme">@style/blinkt.BottomSheet</item>

        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="actionBarStyle">@style/blinkt.actionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>

        <!-- Preserve the app's near-black surfaces in dark mode -->
        <item name="android:colorBackground">#111111</item>
        <item name="android:windowBackground">#111111</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorSurfaceContainerLowest">#111111</item>
        <item name="colorSurfaceContainerLow">#1A1A1A</item>
        <item name="colorSurfaceContainer">#252525</item>
        <item name="colorSurfaceContainerHigh">#2E2E2E</item>
        <item name="colorSurfaceContainerHighest">#333333</item>
        <item name="colorBackgroundFloating">#252525</item>
        <item name="android:colorBackgroundFloating">#252525</item>

        <!-- Crisp light-on-dark content color for surfaces (switch bars, dialogs, cards) -->
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B3FFFFFF</item>
    </style>

    <style name="blinkt.dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/blinkt.alertDialog</item>
        <!-- Force #252525 background in dark mode for dialogs -->
        <item name="android:colorBackground">#252525</item>
        <item name="android:windowBackground">#252525</item>
        
        <item name="colorBackgroundFloating">#252525</item>
        <item name="android:colorBackgroundFloating">#252525</item>
        
        <!-- Force black status bar for dialog activities -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="blinkt.alertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <!-- Elevated dialog surface, matches MaterialAlertDialog (colorSurfaceContainerHigh) -->
        <item name="android:colorBackground">#2E2E2E</item>
        <item name="colorSurface">#2E2E2E</item>
        <item name="colorSurfaceContainerHigh">#2E2E2E</item>
        <item name="colorBackgroundFloating">#2E2E2E</item>
        <item name="android:colorBackgroundFloating">#2E2E2E</item>

        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="blinkt.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">#333333</item>
        <item name="colorSurfaceContainerLow">#333333</item>
        <item name="bottomSheetStyle">@style/blinkt.BottomSheetStyle</item>
    </style>

    <style name="blinkt.BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">#333333</item>
    </style>

    <!-- Custom preference theme to remove default padding -->
    <style name="blinkt.preferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceScreenStyle">@style/blinkt.preferenceScreen</item>
        <item name="preferenceCategoryStyle">@style/blinkt.preferenceCategory</item>
        <item name="preferenceStyle">@style/blinkt.preference</item>
        <item name="checkBoxPreferenceStyle">@style/blinkt.checkBoxPreference</item>
        <item name="switchPreferenceStyle">@style/blinkt.switchPreference</item>
        <item name="preferenceInformationStyle">@style/blinkt.preference</item>
        <item name="dialogPreferenceStyle">@style/Preference.DialogPreference</item>
        <item name="editTextPreferenceStyle">@style/blinkt.editTextPreference</item>
        <!-- Preference titles render via ?android:attr/textAppearanceListItem (the
             android:titleTextAppearance items below are not real Preference attrs).
             Force a consistent size so these tabs match the custom-layout tabs
             instead of the oversized framework default. -->
        <item name="android:textAppearanceListItem">@style/blinkt.preferenceTitle</item>
    </style>

    <style name="blinkt.preferenceScreen" parent="Preference.PreferenceScreen">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
    </style>
    
    <style name="blinkt.preferenceCategory" parent="Preference.Category">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    
    <style name="blinkt.preference" parent="Preference">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:titleTextAppearance">@style/blinkt.preferenceTitle</item>
    </style>
    
    <style name="blinkt.checkBoxPreference" parent="Preference.CheckBoxPreference">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:titleTextAppearance">@style/blinkt.preferenceTitle</item>
    </style>

    <style name="blinkt.switchPreference" parent="Preference.SwitchPreference">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:titleTextAppearance">@style/blinkt.preferenceTitle</item>
    </style>
    
    <style name="blinkt.preferenceTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
    </style>

</resources>
