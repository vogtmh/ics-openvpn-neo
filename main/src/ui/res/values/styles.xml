<resources>

    <style name="blinkt.baseTheme" parent="Theme.Material3.DayNight">
        <!-- Brand accent drives buttons, switches, progress, etc. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Kept for any remaining AppCompat widgets -->
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimaryDark">#000000</item>

        <item name="alertDialogTheme">@style/blinkt.alertDialog</item>
        <item name="materialAlertDialogTheme">@style/blinkt.materialAlertDialog</item>
        <item name="preferenceTheme">@style/blinkt.preferenceTheme</item>
        <item name="bottomSheetDialogTheme">@style/blinkt.BottomSheet</item>

        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Keep the action bar black with light content in both light and dark mode -->
        <item name="actionBarStyle">@style/blinkt.actionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <style name="blinkt.actionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@android:color/black</item>
        <item name="elevation">0dp</item>
        <!-- The bar is always black, so force a light title in both light and dark mode.
             (The Material3 title uses ?attr/colorOnSurface, which the Dark.ActionBar
             overlay does not remap, leaving it dark on black in light mode.) -->
        <item name="titleTextStyle">@style/blinkt.actionBar.Title</item>
    </style>

    <style name="blinkt.actionBar.Title" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="blinkt.dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/blinkt.alertDialog</item>
        
        <!-- Force black status bar for dialog activities -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="blinkt.alertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- True Material3 alert dialog theme used by MaterialAlertDialogBuilder.
         Surfaces/text/buttons are inherited from the app theme's M3 color scheme
         (colorSurfaceContainerHigh, colorOnSurface, colorPrimary) so light and
         dark dialogs stay consistent without per-dialog hardcoded colors. -->
    <style name="blinkt.materialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="blinkt.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/blinkt.BottomSheetStyle</item>
    </style>

    <style name="blinkt.BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal" />


    <style name="blinkt" parent="blinkt.baseTheme" />


    <style name="item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="faqitem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="faqhead">
        <item name="android:paddingTop">10sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
        <!-- <item name="android:singleLine">true</item> -->
    </style>

    <style name="accountSetupButton">
        <item name="android:layout_width">160sp</item>
        <item name="android:layout_height">40sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="Theme.CreateShortCut" parent="android:Theme.Holo.DialogWhenLarge" />

    <style name="logWindowStatusText">
        <item name="android:paddingLeft">@dimen/paddingItemsSidebarLog</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
    </style>

    <style name="logWindowStatusTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>


    <style name="blinkt.translucent" parent="blinkt.dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="blinkt.tabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabIndicatorHeight">4dp</item>
        <item name="android:background">@color/primary</item>


        <item name="tabBackground">@color/primary</item>
        <item name="tabTextAppearance">@style/AppTabTextAppearance</item>
        <item name="tabSelectedTextColor">@android:color/white</item>

        <item name="tabGravity">fill</item>
        <item name="tabMaxWidth">0dp</item>

    </style>

    <!-- Custom preference theme to remove default padding -->
    <style name="blinkt.preferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceScreenStyle">@style/blinkt.preferenceScreen</item>
        <item name="preferenceCategoryStyle">@style/blinkt.preferenceCategory</item>
        <item name="preferenceStyle">@style/blinkt.preference</item>
        <item name="checkBoxPreferenceStyle">@style/blinkt.checkBoxPreference</item>
        <item name="switchPreferenceStyle">@style/blinkt.switchPreference</item>
        <item name="preferenceInformationStyle">@style/blinkt.preference</item>
        <item name="dialogPreferenceStyle">@style/Preference.DialogPreference</item>
        <item name="editTextPreferenceStyle">@style/blinkt.editTextPreference</item>
        <!-- Preference titles render via ?android:attr/textAppearanceListItem (the
             android:titleTextAppearance items below are not real Preference attrs).
             Force a consistent size so these tabs match the custom-layout tabs
             instead of the oversized framework default. -->
        <item name="android:textAppearanceListItem">@style/blinkt.preferenceTitle</item>
    </style>

    <style name="blinkt.preferenceScreen" parent="Preference.PreferenceScreen">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
    </style>
    
    <style name="blinkt.preferenceCategory" parent="Preference.Category">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    
    <style name="blinkt.preference" parent="Preference">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:titleTextAppearance">@style/blinkt.preferenceTitle</item>
    </style>
    
    <style name="blinkt.editTextPreference" parent="Preference.DialogPreference.EditTextPreference">
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="blinkt.checkBoxPreference" parent="Preference.CheckBoxPreference">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:titleTextAppearance">@style/blinkt.preferenceTitle</item>
    </style>

    <style name="blinkt.switchPreference" parent="Preference.SwitchPreference">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:titleTextAppearance">@style/blinkt.preferenceTitle</item>
    </style>
    
    <style name="blinkt.preferenceTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="AppTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tab_text</item>
    </style>


</resources>