<resources>

    <!--
      ~ App theme. Colors are defined ONCE as tokens in res/values/colors.xml
      ~ (light) and res/values-night/colors.xml (dark); this theme only maps
      ~ Material3 attributes to those tokens, so there is a single source of
      ~ truth for the color scheme and no per-file/per-dialog hardcoded hex.
      -->
    <style name="Base.Theme.OpenVPNNeo" parent="Theme.Material3.DayNight">
        <!-- Brand accent drives buttons, switches, progress, etc. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>

        <!-- Surface ramp (near-black in dark mode) -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorBackgroundFloating">@color/dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>

        <!-- Component themes -->
        <item name="alertDialogTheme">@style/ThemeOverlay.OpenVPNNeo.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.OpenVPNNeo.MaterialAlertDialog</item>
        <item name="preferenceTheme">@style/ThemeOverlay.OpenVPNNeo.Preference</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.OpenVPNNeo.BottomSheet</item>

        <!-- System bars stay black in both light and dark mode -->
        <item name="android:navigationBarColor">@color/bar_background</item>
        <item name="android:statusBarColor">@color/bar_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Action bar stays black with light content in both modes -->
        <item name="actionBarStyle">@style/Widget.OpenVPNNeo.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <!-- Public theme name used by the manifest -->
    <style name="Theme.OpenVPNNeo" parent="Base.Theme.OpenVPNNeo" />

    <!-- Dialog-styled activities (CredentialsPopup, ConfigConverter, CreateShortcuts, ...) -->
    <style name="Theme.OpenVPNNeo.Dialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.OpenVPNNeo.AlertDialog</item>

        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="android:windowBackground">@color/dialog_surface</item>
        <item name="colorBackgroundFloating">@color/dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>

        <item name="android:statusBarColor">@color/bar_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Action bar: always black, forced light title in both modes -->
    <style name="Widget.OpenVPNNeo.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/bar_background</item>
        <item name="elevation">0dp</item>
        <!-- The M3 title uses ?attr/colorOnSurface, which the Dark.ActionBar overlay
             does not remap, so force a light title explicitly. -->
        <item name="titleTextStyle">@style/TextAppearance.OpenVPNNeo.ActionBarTitle</item>
    </style>

    <style name="TextAppearance.OpenVPNNeo.ActionBarTitle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">@color/on_bar</item>
    </style>

    <!-- AppCompat alert dialogs (used by the preference framework dialogs) -->
    <style name="ThemeOverlay.OpenVPNNeo.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorBackgroundFloating">@color/dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/dialog_surface</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Material dialogs created with MaterialAlertDialogBuilder.
         Background/text/buttons come from the app's M3 scheme, so nothing is
         hardcoded here beyond the accent and dialog width. -->
    <style name="ThemeOverlay.OpenVPNNeo.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Bottom sheets -->
    <style name="ThemeOverlay.OpenVPNNeo.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.OpenVPNNeo.BottomSheet</item>
    </style>

    <style name="Widget.OpenVPNNeo.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/bottom_sheet_surface</item>
    </style>

    <!-- Profile editor tab bar: sits on the (black) app bar so it reads as one header.
         Tabs are icon-only; the selected tab's icon is tinted with the accent color
         (no underline indicator). The current section name is shown as a heading above
         the pager content (see vpn_preferences.xml / the fragments). -->
    <style name="Widget.OpenVPNNeo.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/bar_background</item>
        <item name="tabIndicatorHeight">0dp</item>
        <item name="tabIconTint">@color/tab_icon_tint</item>
        <item name="tabGravity">fill</item>
    </style>

    <!--
      ~ Preferences. All preference types share ONE row layout (@layout/ovpn_preference)
      ~ whose title uses @style/TextAppearance.OpenVPNNeo.Title. This makes the
      ~ preference-based tabs (IP/Routing/Auth/Advanced) match the custom-layout tabs
      ~ instead of the oversized framework default.
      -->
    <style name="ThemeOverlay.OpenVPNNeo.Preference" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceScreenStyle">@style/Widget.OpenVPNNeo.Preference.Screen</item>
        <item name="preferenceCategoryStyle">@style/Widget.OpenVPNNeo.Preference.Category</item>
        <item name="preferenceStyle">@style/Widget.OpenVPNNeo.Preference</item>
        <item name="preferenceInformationStyle">@style/Widget.OpenVPNNeo.Preference</item>
        <item name="checkBoxPreferenceStyle">@style/Widget.OpenVPNNeo.Preference.CheckBox</item>
        <item name="switchPreferenceStyle">@style/Widget.OpenVPNNeo.Preference.Switch</item>
        <item name="switchPreferenceCompatStyle">@style/Widget.OpenVPNNeo.Preference.Switch</item>
        <item name="dialogPreferenceStyle">@style/Widget.OpenVPNNeo.Preference.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Widget.OpenVPNNeo.Preference.EditText</item>
    </style>

    <style name="Widget.OpenVPNNeo.Preference.Screen" parent="Preference.PreferenceScreen" />

    <style name="Widget.OpenVPNNeo.Preference.Category" parent="Preference.Category">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Widget.OpenVPNNeo.Preference" parent="Preference">
        <item name="android:layout">@layout/ovpn_preference</item>
    </style>

    <style name="Widget.OpenVPNNeo.Preference.CheckBox" parent="Preference.CheckBoxPreference">
        <item name="android:layout">@layout/ovpn_preference</item>
    </style>

    <style name="Widget.OpenVPNNeo.Preference.Switch" parent="Preference.SwitchPreference">
        <item name="android:layout">@layout/ovpn_preference</item>
        <item name="android:widgetLayout">@layout/ovpn_pref_switch_widget</item>
    </style>

    <style name="Widget.OpenVPNNeo.Preference.Dialog" parent="Preference.DialogPreference">
        <item name="android:layout">@layout/ovpn_preference</item>
    </style>

    <style name="Widget.OpenVPNNeo.Preference.EditText" parent="Preference.DialogPreference.EditTextPreference">
        <item name="android:layout">@layout/ovpn_preference</item>
    </style>

    <!-- Shared "setting title" appearance (18sp, matches the custom-layout tabs) -->
    <style name="TextAppearance.OpenVPNNeo.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Selector control buttons in the profile editor (the arrow "›" button and the
         "open file" pill). Sized to match the MaterialSwitch toggles so every row
         control has the same footprint. -->
    <style name="Widget.OpenVPNNeo.SelectorButton" parent="">
        <item name="android:layout_width">@dimen/selector_control_width</item>
        <item name="android:layout_height">@dimen/selector_control_height</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">@drawable/settings_action_button_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Section heading shown as the first (scrolling) line of each profile-editor page. -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>


    <!-- ============================================================
         Legacy shared styles (still used by custom, non-preference layouts).
         ============================================================ -->

    <style name="item">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="faqitem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="faqhead">
        <item name="android:paddingTop">10sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
    </style>

    <style name="accountSetupButton">
        <item name="android:layout_width">160sp</item>
        <item name="android:layout_height">40sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="logWindowStatusText">
        <item name="android:paddingLeft">@dimen/paddingItemsSidebarLog</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceLarge</item>
    </style>

    <style name="logWindowStatusTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="AppTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tab_text</item>
    </style>

</resources>
