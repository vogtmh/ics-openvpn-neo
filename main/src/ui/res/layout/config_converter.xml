<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <RelativeLayout xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/root_layout_config_converter"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/stdpadding"
                android:orientation="vertical">


            <LinearLayout
                    android:id="@+id/config_convert_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/profilename_label"
                        style="@style/item"
                        android:labelFor="@id/profilename"
                        android:text="@string/profilename"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        tools:visibility="visible"
                        android:visibility="gone" />

                <EditText
                        android:id="@+id/profilename"
                        style="@style/item"
                        android:inputType="text"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/make_default_profile"
                        android:nextFocusDown="@+id/make_default_profile"
                        android:nextFocusLeft="@+id/make_default_profile"
                        android:nextFocusRight="@+id/make_default_profile"
                        tools:visibility="visible"
                        android:visibility="gone" />

                <LinearLayout
                        android:id="@+id/make_default_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/set_as_default_profile"
                            android:textAppearance="?android:attr/textAppearanceMedium" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/make_default_profile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                        android:id="@+id/make_favorite_profile_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mark_as_favorite"
                            android:textAppearance="?android:attr/textAppearanceMedium" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/make_favorite_profile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/import_username_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="@string/auth_username"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/import_username"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/import_userpassword_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:endIconMode="password_toggle"
                        android:hint="@string/password"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/import_userpassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/import_password_layout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:endIconMode="password_toggle"
                        android:hint="@string/private_key_password"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/import_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                        android:id="@+id/files_missing_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/files_missing_hint"
                        android:visibility="gone"
                        tools:visibilty="visible" />

                <TextView
                        android:id="@+id/permssion_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="@string/query_permissions_sdcard"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/stdpadding"
                        android:visibility="gone"
                        tools:visibility="visible">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/importpkcs12fromconfig"
                            android:textAppearance="?android:attr/textAppearanceMedium" />
                            
                        <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/importpkcs12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:focusable="true"
                                android:focusableInTouchMode="true" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/show_import_log_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/show_import_log"
                        android:visibility="gone"
                        tools:visibility="visible" />

                <LinearLayout
                        android:id="@+id/import_log_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                                android:id="@+id/textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:text="@string/import_log"
                                android:textAppearance="?android:attr/textAppearanceMedium" />
                </LinearLayout>

                <Space
                        android:id="@+id/fab_footerspace"
                        android:layout_width="40dp"
                        android:layout_height="@dimen/round_button_diameter"
                        android:visibility="gone" />
            </LinearLayout>

        </ScrollView>

    </RelativeLayout>
</FrameLayout>
